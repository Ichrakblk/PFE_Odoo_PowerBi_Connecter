<odoo>

    <!-- Vue Kanban pour power_bi.dataset -->
    <record id="view_power_bi_dataset_kanban" model="ir.ui.view">
        <field name="name">power.bi.dataset.kanban</field>
        <field name="model">power_bi.dataset</field>
        <field name="arch" type="xml">
            <kanban string="Jeux de données Power BI" class="o_kanban_power_bi">
    <field name="name"/>
    <field name="workspace_id"/>
    <field name="table_ids"/>
    <field name="decorated_state" widget="html"/>
    <templates>
        <t t-name="kanban-box">
            <div t-attf-class="oe_kanban_global_click o_kanban_card" style="background: linear-gradient(to bottom right, #f0f4ff, #e3f2fd); border-radius: 12px; padding: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                <div style="text-align: center;">
                    <div class="o_kanban_record_icon" style="font-size: 45px; color: #0056b3;">
                        <i class="fa fa-database"/>
                    </div>
                    <div style="font-weight: bold; font-size: 18px; margin: 5px 0; color: #333;">
                        <field name="name"/>
                    </div>
                    <div style="font-size: 14px; color: #666;">
                        <field name="workspace_id"/>
                    </div>
                    <div style="margin-top: 10px;">
                        <field name="decorated_state" widget="html"/>
                    </div>
                </div>
            </div>
        </t>
    </templates>
</kanban>

        </field>
    </record>


    <record id="view_power_bi_dataset_form" model="ir.ui.view">
        <field name="name">power.bi.dataset.form</field>
        <field name="model">power_bi.dataset</field>
        <field name="arch" type="xml">
            <form string="Jeu de données Power BI">
    <header>
        <button name="action_publish_to_power_bi"
                type="object"
                string="📤 Publish to Power BI"
                class="btn btn-primary"
                style="background-color: #007bff; color: white; font-weight: bold; margin-right: 50px;"
                />
        <field name="state" widget="statusbar" statusbar_visible="draft,published"
               style="margin-left: auto; margin-right: 30px;"/>
    </header>

    <div class="oe_title" style="margin-top: 10px;">
        <h2 style="text-align: center; color: #004085;">Power BI Dataset details</h2>
    </div>

    <sheet>
        <group>
            <field name="name" readonly="state == 'published'" style="font-weight: bold; color: #003366;"/>
            <field name="workspace_id" readonly="state == 'published'"/>
            <field name="table_ids" readonly="state == 'published'" widget="many2many_tags"/>
        </group>

        <notebook>
            <page string="📌 Fields">
                <group>
                    <field name="selected_field_ids" options="{'no_create': True}" readonly="1">
                        <tree decoration-info="1">
                            <field name="name"/>
                            <field name="field_description"/>
                            <field name="model"/>
                            <field name="ttype"/>
                            <field name="readonly"/>
                        </tree>
                    </field>
                </group>
            </page>
            <page string="🔗 Merged Fields ">
                <group>
                    <field name="related_field_ids" options="{'no_create': True}" readonly="1">
                        <tree decoration-success="1">
                            <field name="name"/>
                            <field name="field_description"/>
                            <field name="model"/>
                            <field name="ttype"/>
                            <field name="readonly"/>
                        </tree>
                    </field>
                </group>
            </page>
        </notebook>

        <div class="oe_button_box" name="button_box" style="margin-top: 20px;">
            <button class="oe_stat_button" type="object" name="action_show_tables" icon="fa-table">
                <field name="table_ids" widget="statinfo" string="Tables"/>
            </button>
        </div>
    </sheet>

    <div class="oe_chatter">
        <field name="message_follower_ids" widget="mail_followers"/>
        <field name="message_ids" widget="mail_thread"/>
    </div>
</form>

        </field>
    </record>

    <record id="view_power_bi_dataset_select_tables" model="ir.ui.view">
        <field name="name">power.bi.dataset.select.tables</field>
        <field name="model">power_bi.dataset</field>
        <field name="arch" type="xml">
            <form string="Sélectionner des Tables">
                <sheet>
                    <group>
                        <field name="table_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <button name="action_save_selected_tables" type="object" class="oe_highlight" string="Save"/>
                    </group>
                </sheet>
                <footer>
                    <button special="cancel" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_powerbi_datasets" model="ir.actions.act_window">
        <field name="name">DataSet Power BI</field>
        <field name="res_model">power_bi.dataset</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_power_bi_dataset_kanban"/>
    </record>

</odoo>
