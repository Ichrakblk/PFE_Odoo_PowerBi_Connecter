<odoo>

    <record id="view_power_bi_dataset_tree" model="ir.ui.view">
        <field name="name">power.bi.dataset.tree</field>
        <field name="model">power_bi.dataset</field>
        <field name="arch" type="xml">
            <tree string="Jeux de données Power BI">
                <field name="name"/>
                <field name="workspace_id"/>

                <field name="decorated_state" widget="html"/>
            </tree>
        </field>
    </record>

    <record id="view_power_bi_dataset_form" model="ir.ui.view">
        <field name="name">power.bi.dataset.form</field>
        <field name="model">power_bi.dataset</field>
        <field name="arch" type="xml">
            <form string="Jeu de données Power BI">
                <header>
                        <button name="action_publish_to_power_bi" type="object" string="Publish to Power BI" class="btn-primary" style="margin-right: 200px;" icon="fa-upload"/>
                        <field name="state" widget="statusbar" statusbar_visible="to_publish,published" style="margin-top: 30px; margin-left: 1140px; margin-bottom: 30px"/>

                </header>
                <div class="oe_title">
        <div class="oe_ribbon oe_read_only" modifiers="{'invisible': [['state', '!=', 'published']]}">
            <span class="oe_ribbon_text">Confirmé</span>
        </div>
    </div>
                <sheet>


                    <group>
                        <field name="name"/>
                        <field name="workspace_id"/>
                        <field name="table_ids" />
                    </group>
                    <notebook>
                        <page string="Fields ">
                            <group>
                                <field name="selected_field_ids" options="{'no_create': True}" readonly="1">
                                <tree>
                    <field name="name" string="Field Name"/>
                    <field name="field_description" string="Field Label"/>
                                    <field name="model" string="Model"/>
                                     <field name="ttype" string="Field Type"/>
                                                        <field name="readonly" string="ReadOnly"/>


                </tree>
                                </field>
                            </group>
                        </page>
                    </notebook>
                    <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="action_show_tables" icon="fa-table">
                        <field name="table_ids" widget="statinfo" string="Tables"/>
                    </button>
                </div>
                </sheet>

<div class="oe_chatter">
    <field name="message_follower_ids" widget="mail_followers"/>
    <field name="message_ids" widget="mail_thread"/>
</div>

            </form>
        </field>
    </record>

    <record id="view_power_bi_dataset_select_tables" model="ir.ui.view">
        <field name="name">power.bi.dataset.select.tables</field>
        <field name="model">power_bi.dataset</field>
        <field name="arch" type="xml">
            <form string="Sélectionner des Tables">
                <sheet>
                    <group>
                        <field name="table_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <button name="action_save_selected_tables" type="object" class="oe_highlight" string="Save"/>
                    </group>
                </sheet>
                <footer>
                    <button special="cancel" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_powerbi_datasets" model="ir.actions.act_window">
        <field name="name">DataSet Power BI</field>
        <field name="res_model">power_bi.dataset</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
