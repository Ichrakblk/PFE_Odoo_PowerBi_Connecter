<odoo>
    <record id="view_choose_report_wizard_form" model="ir.ui.view">
        <field name="name">choose.report.wizard.form</field>
        <field name="model">choose.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Choisir un rapport">
                <group>
                    <field name="report_id" widget="many2one" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_select_report" string="Sélectionner" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
