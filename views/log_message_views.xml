<odoo>
    <record id="view_log_message_tree" model="ir.ui.view">
    <field name="name">log.message.tree</field>
    <field name="model">log.message</field>
    <field name="arch" type="xml">
        <tree string="📜 Messages de log">
            <field name="log_date" string="🕒 Date"/>
            <field name="message" string="🧠 Sujet"/>
            <field name="log_message" string="📝 Détail"/>
        </tree>
    </field>
</record>

    <record id="view_log_message_form" model="ir.ui.view">
    <field name="name">log.message.form</field>
    <field name="model">log.message</field>
    <field name="arch" type="xml">
        <form string="📥 Message de Log" class="o_form_sheet_bg">
            <header>
                <button name="action_download_report"
                        string="⬇️ Download the report"
                        type="object" class="oe_highlight"
                        />
            </header>

            <sheet>
                <div class="oe_title">
                    <h2 style="color:#2c3e50; font-weight:700;">
                        🧠 <field name="message" readonly="1"/>
                    </h2>
                </div>

                <group>
                    <group col="2" string="🕒 Informations">
                        <field name="log_date" string="🗓️ Date"/>
                        <field name="log_message" string="📝 Détail"/>
                    </group>

                    <group col="1" string="📄 Rapport PDF">
                        <field name="pdf_file" widget="pfe_viewer" style="height:400px; border: 1px solid #ddd;"/>
                    </group>
                </group>
            </sheet>


        </form>
    </field>
</record>

    <record id="action_report_log_message" model="ir.actions.report">
        <field name="name">Log Report</field>
        <field name="model">log.message</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_powerbi_connector.report_log_message</field>
        <field name="report_file">custom_powerbi_connector.report_log_message</field>
        <field name="attachment_use">True</field>
    </record>

    <report
        id="report_log_message"
        model="log.message"
        string="Log Report"
        report_type="qweb-pdf"
        name="custom_powerbi_connector.report_log_message"
        file="custom_powerbi_connector.report_log_message"
        attachment_use="True"/>


    <record id="action_log_message" model="ir.actions.act_window">
        <field name="name">Log Messages</field>
        <field name="res_model">log.message</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No log messages have been recorded yet.
            </p>
        </field>
    </record>


</odoo>
