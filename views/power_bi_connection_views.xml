<odoo>
    <record id="view_powerbi_connection_form" model="ir.ui.view">
        <field name="name">power.bi.connection.form</field>
        <field name="model">power_bi.connection</field>
        <field name="arch" type="xml">
            <form string="🔌 Power BI Connection" class="oe_form_sheet">

                <header>
                    <button name="existe_workspace_popup" type="object" string="Check Existing Workspaces" class="btn-primary" icon="fa-search"/>
                    <field name="state" widget="statusbar" statusbar_visible="not_connected,connected"/>
                </header>

                <sheet>
                    <group string="Connection Details" col="2">

                        <field name="name" readonly="state == 'connected'" placeholder="e.g., My Power BI Connection"/>
                        <field name="tenant_id" readonly="state == 'connected'" placeholder="Enter Tenant ID"/>
                        <field name="client_id" readonly="state == 'connected'" placeholder="Enter Client ID"/>
                        <field name="client_secret" readonly="state == 'connected'" password="True" placeholder="Enter Client Secret"/>
                    </group>

                    <group>
                        <button name="action_test_connection" type="object" string="🔄 Test Connection" class="oe_highlight" />
                    </group>

                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_test_connection" class="oe_stat_button" icon="fa-database">
                            <div class="o_stat_info">
                                <field name="workspace_count" string="Workspaces"/>
                            </div>
                        </button>
                    </div>
                </sheet>

            </form>
        </field>
    </record>

    <record id="view_powerbi_connection_tree" model="ir.ui.view">
        <field name="name">power.bi.connection.tree</field>
        <field name="model">power_bi.connection</field>
        <field name="arch" type="xml">
            <tree string="Power BI Connections">
                <field name="name"/>
                <field name="state"/>
                <field name="workspace_name"/>
            </tree>
        </field>
    </record>

    <record id="action_powerbi_connections" model="ir.actions.act_window">
        <field name="name">Power BI Connections</field>
        <field name="res_model">power_bi.connection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
