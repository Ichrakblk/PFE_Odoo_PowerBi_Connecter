<odoo>
    <record id="view_powerbi_connection_form" model="ir.ui.view">
        <field name="name">power.bi.connection.form</field>
        <field name="model">power_bi.connection</field>
        <field name="arch" type="xml">
             <form string="Power BI Connection">

                <div class="oe_form_header">

                    <button string="Exist Workspace" type="object" name="existe_workspace_popup" class="btn-primary" style="margin-right: 200px;"/>


                    <field name="state" widget="statusbar" statusbar_visible="not_connected,connected" style="margin-top: 30px; margin-left: 1000px; margin-bottom: 30px"/>
                </div>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tenant_id"/>
                        <field name="client_id"/>
                        <field name="client_secret"/>

                        <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight" icon="fa-cogs"/>
                    </group>

                </sheet>

                <div class="oe_button_box" name="button_box">
                    <button type="object" name="action_test_connection" class="oe_stat_button" icon="fa-database">
                        <field name="workspace_count" string="Workspaces"/>
                    </button>
                </div>

            </form>
        </field>
    </record>

    <record id="view_powerbi_connection_tree" model="ir.ui.view">
        <field name="name">power.bi.connection.tree</field>
        <field name="model">power_bi.connection</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="state"/>
                <field name="workspace_name"/>
            </tree>
        </field>
    </record>

    <record id="action_powerbi_connections" model="ir.actions.act_window">
        <field name="name">Power BI Connections</field>
        <field name="res_model">power_bi.connection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
