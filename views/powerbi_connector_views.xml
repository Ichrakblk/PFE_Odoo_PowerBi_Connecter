<odoo>
    <!-- Form view -->
    <record id="view_powerbi_connector_form" model="ir.ui.view">
        <field name="name">powerbi.connector.form</field>
        <field name="model">powerbi.connector</field>
        <field name="arch" type="xml">
            <form string="Configuration Power BI">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_ids" widget="many2many_tags"/>
                        <field name="sync_frequency"/>
                         <button name="sync_data" type="object" string="Synchroniser maintenant" class="btn-primary"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="view_powerbi_connector_tree" model="ir.ui.view">
        <field name="name">powerbi.connector.tree</field>
        <field name="model">powerbi.connector</field>
        <field name="arch" type="xml">
            <tree string="Configurations Power BI">
                <field name="name"/>
                <field name="sync_frequency"/>
            </tree>
        </field>
    </record>


    <record id="action_powerbi_connector" model="ir.actions.act_window">
        <field name="name">Configurations Power BI</field>
        <field name="res_model">powerbi.connector</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
